"聊":[{"text":"他们很快就聊起来了。","en":"They fell into the conversation immediately.","source":"tatoeba","id":4760176,"enId":305676,"by":"ryanwoo"},{"text":"我不想聊汤姆的事。","en":"I didn't want to talk about Tom.","source":"tatoeba","id":13887408,"enId":6249335,"by":"jan_OkulaJu"},{"text":"我没有朋友可以聊天。","en":"I have no friend to talk with.","source":"tatoeba","id":706430,"enId":250020,"by":"sysko"},{"text":"卡瑞娜聊过那个男人的","source":"aishell3","id":"SSB06230049"},{"text":"我们聊的很愉快","source":"aishell3","id":"SSB11380209"}],
"聊了":[{"text":"汤姆和玛丽聊了一个晚上。","en":"Tom talked with Mary all night.","source":"tatoeba","id":1878014,"enId":1027974,"by":"fercheung"},{"text":"我和汤姆聊了一会。","en":"I had a conversation with Tom.","source":"tatoeba","id":13894764,"enId":2331562,"by":"jan_OkulaJu"},{"text":"你跟我聊了这么久不知道我叫什么？！","en":"You've been talking to me for so long, don't you know my name?!","source":"tatoeba","id":1523939,"enId":7221546,"by":"sysko"},{"text":"我和他以及教练组聊了四十分钟","source":"aishell1","id":"BAC009S0513W0349"},{"text":"之前孙海平指导跟我聊了很多","source":"aishell1","id":"BAC009S0515W0355"}],
