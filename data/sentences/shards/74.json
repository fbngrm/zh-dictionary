"聊天":[{"text":"我没有朋友可以聊天。","en":"I have no friend to talk with.","source":"tatoeba","id":706430,"enId":250020,"by":"sysko"},{"text":"萨米去和蕾拉聊天了。","en":"Sami went to talk to Layla.","source":"tatoeba","id":8975265,"enId":7279701,"by":"WilsonWong"},{"text":"我现在不能和你聊天。","en":"I cannot talk to you now.","source":"tatoeba","id":13876782,"enId":8013732,"by":"jan_OkulaJu"},{"text":"日本推出新型聊天机器人","source":"aishell3","id":"SSB17450287"},{"text":"喜欢这样舒适聊天的下午","source":"aishell3","id":"SSB13830374"}],
