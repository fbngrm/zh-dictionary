"聊天":[{"text":"Nancy正在和她的朋友们聊天。","en":"Nancy is having a chat with her friends.","source":"tatoeba","id":353527,"enId":36175,"by":"ruicong"},{"text":"我要么去看电影，要么和朋友聊天。","en":"I am either going to watch a movie, or chat with my friends.","source":"tatoeba","id":380679,"enId":7842262,"by":"sysko"},{"text":"我没有朋友可以聊天。","en":"I have no friend to talk with.","source":"tatoeba","id":706430,"enId":250020,"by":"sysko"},{"text":"日本推出新型聊天机器人","source":"aishell3","id":"SSB17450287"},{"text":"喜欢这样舒适聊天的下午","source":"aishell3","id":"SSB13830374"}],
