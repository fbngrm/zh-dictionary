"酸甜苦辣":[{"text":"也浓缩着许许多多平常人的酸甜苦辣","source":"aishell1","id":"BAC009S0015W0470"}],
"酸疼":[{"text":"要么在健身房里挥汗如雨全身酸疼","source":"aishell1","id":"BAC009S0518W0472"},{"text":"腿部腰部的酸疼对我来说是一场挑战","source":"aishell1","id":"BAC009S0753W0382"}],
"酸痛":[{"text":"我发烧了，全身酸痛。","en":"I have a fever and I ache all over.","source":"tatoeba","id":14037696,"enId":282100,"by":"jan_OkulaJu"},{"text":"我全身酸痛。","en":"I ache all over.","source":"tatoeba","id":917936,"enId":63521,"by":"Martha"},{"text":"她浑身酸痛。","en":"She was aching from head to foot.","source":"tatoeba","id":8738025,"enId":275268,"by":"slo_oth"},{"text":"原以为只是肌肉酸痛","source":"aishell1","id":"BAC009S0335W0465"},{"text":"原本就容易造成肩颈僵硬和酸痛","source":"aishell3","id":"SSB06930260"}],
"酸葡萄":[{"text":"甚至可以说是酸葡萄心理","source":"aishell1","id":"BAC009S0105W0261"}],
"酸雨":[{"text":"酸雨不是自然现象。","en":"Acid rain is not a natural phenomenon.","source":"tatoeba","id":334644,"enId":245182,"by":"fucongcong"}],
"驸":[{"text":"黄梅戏女驸马","source":"aishell3","id":"SSB18780090"}],
"驸马":[{"text":"黄梅戏女驸马","source":"aishell3","id":"SSB18780090"}]
