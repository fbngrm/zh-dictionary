{
  "name": "@fbngrm/zh-dictionary",
  "version": "0.5.0",
  "private": true,
  "description": "Chinese–English word lookup for JS apps: pinyin, traditional forms, translations and character decomposition, with data shipped separately from the code.",
  "license": "MIT AND CC0-1.0 AND CC-BY-SA-4.0 AND Unicode-3.0",
  "repository": "github:fbngrm/zh-dictionary",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "modes",
    "data",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zh": {
      "types": "./modes/zh.d.ts",
      "default": "./modes/zh.js"
    },
    "./cedict": {
      "types": "./modes/cedict.d.ts",
      "default": "./modes/cedict.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./data/zh.json": "./data/zh/dictionary.json",
    "./data/cedict.json": "./data/cedict/cedict.json",
    "./data/cedict.meta.json": "./data/cedict/meta.json",
    "./data/hanzi.json": "./data/hanzi/hanzi.json",
    "./data/hanzi.meta.json": "./data/hanzi/meta.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:cedict": "node scripts/build-cedict.mjs",
    "build:hanzi": "node scripts/build-hanzi.mjs",
    "build:traditional": "node scripts/build-traditional.mjs",
    "test": "npm run build && node --test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
