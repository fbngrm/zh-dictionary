{
  "name": "@fbngrm/zh-dictionary",
  "version": "0.4.0",
  "private": true,
  "description": "Chinese–English word lookup for JS apps, with data shipped separately from the code.",
  "license": "MIT AND CC0-1.0",
  "repository": "github:fbngrm/zh-dictionary",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/zh.json": "./data/zh/dictionary.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:traditional": "node scripts/build-traditional.mjs",
    "test": "npm run build && node --test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
